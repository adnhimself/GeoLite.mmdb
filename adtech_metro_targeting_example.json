  "database_schemas": {
    "campaigns": {
      "id": "INTEGER PRIMARY KEY",
      "name": "TEXT",
      "targeting_type": "TEXT",
      "created_at": "TIMESTAMP"
    },
    "campaign_targeting": {
      "id": "INTEGER PRIMARY KEY",
      "campaign_id": "INTEGER",
      "target_type": "TEXT",
      "target_value": "TEXT",
      "created_at": "TIMESTAMP"
    },
    "ip_logs": {
      "id": "INTEGER PRIMARY KEY",
      "ip_address": "TEXT",
      "city": "TEXT",
      "state_code": "TEXT",
      "campaign_id": "INTEGER",
      "matched": "BOOLEAN",
      "timestamp": "TIMESTAMP"
    }
  },
  "api_examples": {
    "create_campaign": {
      "endpoint": "POST /api/campaigns",
      "request_body": {
        "name": "Buffalo Metro Campaign",
        "targeting": {
          "type": "metro",
          "metros": ["Buffalo Metro Area"],
          "states": ["NY"]
        }
      },
      "response": {
        "campaign_id": 123,
        "expanded_cities": [
          "Buffalo", "Amherst", "Cheektowaga", "Clarence", "Depew", "East Amherst", 
          "Kenmore", "Lackawanna", "Lancaster", "Tonawanda", "West Seneca", 
          "Williamsville", "Niagara Falls", "Lockport", "North Tonawanda"
        ],
        "targeting_records_created": 15
      }
    },
    "check_ip_match": {
      "endpoint": "POST /api/check-targeting",
      "request_body": {
        "ip_address": "74.77.103.181",
        "campaign_id": 123
      },
      "response": {
        "matched": true,
        "city": "Buffalo",
        "state_code": "NY",
        "metro_area": "Buffalo Metro Area",
        "postal_code": "14211"
      }
    }
  },
