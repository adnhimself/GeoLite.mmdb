    "description": "Function to match IP addresses against campaign targeting in real-time",
    "parameters": {
      "ip_address": "string",
      "campaign_id": "integer"
    },
    "process": [
      "1. Use MaxMind MMDB to get city and state from IP",
      "2. Query campaign_targeting table for this campaign",
      "3. Check if detected city matches any targeted cities",
      "4. Log result to ip_logs table",
      "5. Return match status"
    ],
